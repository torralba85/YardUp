{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "expo-native",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 8081,
      "autoPort": true
    },
    {
      "name": "firebase-emulators",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["firebase", "emulators:start"],
      "port": 4000
    },
    {
      "name": "hyperframes-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "adu-design-studio-demo", "run", "dev"],
      "port": 5173,
      "autoPort": true
    }
  ]
}
