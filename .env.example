# LotFoundry local environment template
# Copy to .env.local and replace only the values you need.
# Never commit .env.local, service-account JSON, signing keys, or debug tokens.

# Canonical origin and public browser configuration
NEXT_PUBLIC_APP_URL=https://lotfoundry.net
NEXT_PUBLIC_GOOGLE_PLACES_KEY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable
# analytics entirely: with no ID the tag never loads and the cookie banner
# never appears. Safe to leave unset in local development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-side parcel and mapping providers
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_KEY=
GOOGLE_PLACES_SERVER_KEY=
REGRID_API_KEY=
RENT_API_KEY=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-5.6-sol
AI_RATE_LIMIT_BACKEND=memory

# Firebase web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local authenticated development only. Register this debug token in Firebase
# App Check and never deploy or commit its real value.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Stripe web checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_CERTIFICATE_PRICE_CENTS=2900
NEXT_PUBLIC_LEAD_UNLOCK_PRICE_CENTS=4900

# Native store verification (production server only). Prefer the platform-
# specific flags; the legacy umbrella flag enables both platforms.
ENABLE_NATIVE_STORE_VERIFICATION=false
ENABLE_APPLE_STORE_VERIFICATION=false
ENABLE_GOOGLE_PLAY_VERIFICATION=false
APPLE_BUNDLE_ID=com.lotfoundry.app
APPLE_ROOT_CA_FINGERPRINT256=
GOOGLE_PLAY_PACKAGE_NAME=com.lotfoundry.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Local/demo flags. Never enable public API or demo grants in production.
# LOTFOUNDRY_ALLOW_PUBLIC_API=true
# LOTFOUNDRY_DEMO_UNLOCKS=true
# LOTFOUNDRY_STORE_DEMO=true
# CAPACITOR_SERVER_URL=http://localhost:3000
