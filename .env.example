# LotFoundry local environment template
# Copy to .env.local and replace only the values you need.
# Never commit .env.local, service-account JSON, signing keys, or debug tokens.

# Canonical origin and public browser configuration
NEXT_PUBLIC_APP_URL=https://yardup-2026.web.app
NEXT_PUBLIC_GOOGLE_PLACES_KEY=<browser-restricted-places-key>

# Server-side parcel and mapping providers
GOOGLE_MAPS_API_KEY=<server-maps-key>
GOOGLE_GEOCODING_KEY=<optional-server-geocoding-key>
GOOGLE_PLACES_SERVER_KEY=<optional-server-places-key>
REGRID_API_KEY=<server-regrid-key>
RENT_API_KEY=<optional-rent-data-key>

# OpenAI Responses API
OPENAI_API_KEY=<server-openai-key>
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-5.6-sol
AI_RATE_LIMIT_BACKEND=memory

# Firebase web app
NEXT_PUBLIC_FIREBASE_API_KEY=<firebase-web-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=yardup-2026
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<web-app-id>
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=<recaptcha-enterprise-site-key>

# Local authenticated development only. Register this debug token in Firebase
# App Check and never deploy or commit its real value.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=<registered-local-debug-token>

# Stripe web checkout
STRIPE_SECRET_KEY=<server-stripe-secret>
STRIPE_WEBHOOK_SECRET=<server-stripe-webhook-secret>
NEXT_PUBLIC_CERTIFICATE_PRICE_CENTS=4900
NEXT_PUBLIC_LEAD_UNLOCK_PRICE_CENTS=4900

# Native store verification (production server only)
ENABLE_NATIVE_STORE_VERIFICATION=false
APPLE_BUNDLE_ID=com.lotfoundry.app
APPLE_ROOT_CA_FINGERPRINT256=<apple-root-ca-sha256>
GOOGLE_PLAY_PACKAGE_NAME=com.lotfoundry.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=<android-publisher-service-account-json>

# Local/demo flags. Never enable public API or demo grants in production.
# LOTFOUNDRY_ALLOW_PUBLIC_API=true
# LOTFOUNDRY_DEMO_UNLOCKS=true
# LOTFOUNDRY_STORE_DEMO=true
# CAPACITOR_SERVER_URL=http://localhost:3000
