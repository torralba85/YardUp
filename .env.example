# LotFoundry local environment template
# Copy to .env.local and replace only the values you need.
# Never commit .env.local, service-account JSON, signing keys, or debug tokens.

# Canonical origin and public browser configuration
NEXT_PUBLIC_APP_URL=https://lotfoundry.net
NEXT_PUBLIC_GOOGLE_PLACES_KEY=

# Photorealistic basemap for the Studio's Neighborhood 3D view (internal beta).
# Both are unavoidably browser-visible — restrict them at the provider rather
# than treating them as secrets. Leave both empty and the view falls back to
# OpenStreetMap imagery and says so in its HUD; nothing breaks.
#
# Preferred and the only route licensed for commercial use here. A Google Maps
# Platform browser key with the MAP TILES API enabled, restricted by HTTP
# referrer to lotfoundry.net. Keep it separate from NEXT_PUBLIC_GOOGLE_PLACES_KEY
# so neither key's API restrictions have to be widened for the other. Billed per
# root-tile request ("session"): 1,000 free events/month, then $6.00 CPM.
NEXT_PUBLIC_GOOGLE_MAP_TILES_KEY=
# Fallback route: the same Google data rehosted as Cesium ion asset 2275207, via
# a public `assets:read` token. ion's free Community plan is personal and
# NON-COMMERCIAL, so this is for local development only — a production launch
# needs the Google key above or a paid ion plan.
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# Internal only: "true" shows the Scan view's calibration panel. Leave unset in
# production so public visitors never see it. Read at build time.
NEXT_PUBLIC_SCAN_CALIBRATION=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave empty to disable
# analytics entirely: with no ID the tag never loads and the cookie banner
# never appears. Safe to leave unset in local development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-side parcel and mapping providers
GOOGLE_MAPS_API_KEY=
GOOGLE_GEOCODING_KEY=
GOOGLE_PLACES_SERVER_KEY=
# Optional. Without it /api/parcel still resolves real lots from the free
# public county/statewide GIS services, the keyless US Census geocoder, and
# USA Structures building footprints, falling back to preset dimensions only
# where the parcel services have no coverage.
REGRID_API_KEY=
RENT_API_KEY=

# Resend transactional email
RESEND_API_KEY=

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-5.6-sol
AI_RATE_LIMIT_BACKEND=memory

# Firebase web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Local authenticated development only. Register this debug token in Firebase
# App Check and never deploy or commit its real value.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Stripe web checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_CERTIFICATE_PRICE_CENTS=2900
NEXT_PUBLIC_LEAD_UNLOCK_PRICE_CENTS=4900

# Native store verification (production server only). Prefer the platform-
# specific flags; the legacy umbrella flag enables both platforms.
ENABLE_NATIVE_STORE_VERIFICATION=false
ENABLE_APPLE_STORE_VERIFICATION=false
ENABLE_GOOGLE_PLAY_VERIFICATION=false
APPLE_BUNDLE_ID=com.lotfoundry.app
APPLE_ROOT_CA_FINGERPRINT256=
GOOGLE_PLAY_PACKAGE_NAME=com.lotfoundry.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Local/demo flags. Never enable public API or demo grants in production.
# LOTFOUNDRY_ALLOW_PUBLIC_API=true
# LOTFOUNDRY_DEMO_UNLOCKS=true
# LOTFOUNDRY_STORE_DEMO=true
# CAPACITOR_SERVER_URL=http://localhost:3000
