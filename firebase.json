{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.env*",
      "**/.git/**",
      "**/node_modules/**",
      "server.js",
      ".next/**"
    ],
    "rewrites": [
      {
        "source": "/api/ai/**",
        "function": "apiAi"
      },
      {
        "source": "/api/stripe/**",
        "function": "apiStripe"
      },
      {
        "source": "/api/store/**",
        "function": "apiStore"
      },
      {
        "source": "/api/**",
        "function": "api"
      },
      {
        "source": "**",
        "function": "app"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|woff2|png|svg|jpg|webp)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
