rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - email: string (required, 4-254 chars) - Homeowner or builder contact email
//   - displayName: string (optional, nullable, <= 100 chars) - Member display name
//   - role: string (required, "user" | "builder", immutable on update) - Account role
//   - legalConsent: map (optional on create, receipt-bearing once accepted, immutable version/timestamps) - Legal consent record
//   - createdAt: timestamp (required, immutable on update) - Account creation timestamp
//   - updatedAt: timestamp (required) - Last profile modification timestamp
//
// Collection: users/{userId}/savedScenarios
// Document ID: {scenarioId} (Auto-generated or client UUID)
// Fields:
//   - name: string (required, 1-160 chars) - Feasibility study scenario title
//   - parcelId: string (required, 1-100 chars) - Preset lot identifier or live lot marker
//   - liveParcel: map (optional) - Extended parcel boundaries, zoning, setbacks, and market data
//   - config: map (required) - ADU dimensions, roof type, exterior finish, openings
//   - assumptions: map (required) - Construction costs, soft-cost multipliers, opex, rent scenario
//   - version: int (optional, 2) - Scenario data model schema version
//   - heightConvention: string (optional, "wall") - Height calculation convention
//   - pose: map (optional) - 2D lot placement coordinates and orientation angle
//   - projectBrief: map (optional) - AI-generated feasibility summary and timeline
//   - styleMatchConcept: map (optional) - Style-matched architecture concepts
//   - preapprovedPlan: map (optional) - Curated municipal pre-approved plan reference
//   - createdAt: timestamp (required, request.time) - Scenario save timestamp
//   - updatedAt: timestamp (required, request.time) - Last update timestamp
//   * Access pattern: Create and delete by owning user; update strictly disabled.
//
// Collection: builders
// Document ID: {builderId} (Firebase Auth UID)
// Fields:
//   - ownerUid: string (required, matches builderId) - Owning builder Auth UID
//   - companyName: string (required, 1-160 chars) - Contractor / business name
//   - contactEmail: string (required, 4-254 chars) - Builder business contact email
//   - phone: string (optional, nullable, <= 50 chars) - Phone number
//   - licenseNumber: string (optional, nullable, <= 100 chars) - State contractor license number
//   - serviceAreas: list (required, 1-25 items) - Covered geographic market regions
//   - active: bool (required) - Whether builder is accepting new client matching
//   - credits: number (optional, immutable by client, 0 on create) - Paid lead unlock balance
//   - createdAt: timestamp (required, immutable on update) - Registration timestamp
//   - updatedAt: timestamp (required) - Profile update timestamp
//
// Subcollection: builders/{builderId}/ledger
// Document ID: {transactionId} (Transaction UUID / void reference)
// Fields: Managed strictly by server Admin SDK. Read-only for owning builder.
//
// Collection: connectionRequests
// Document ID: {requestId} (Unique connection request ID)
// Fields:
//   - ownerUid: string (required, matches request.auth.uid) - Homeowner UID
//   - preview: map (required) - Redacted feasibility snapshot without street address or contact info
//   - matchedBuilderIds: list (required, 1-25 items) - Matched eligible builder UIDs
//   - status: string (required, "submitted") - Request lifecycle status
//   - ownerVerified: bool (required, matches verified email token claim) - Homeowner email verification flag
//   - headStartUntil: string (optional, null on create) - Early exclusive window for first unlocker
//   - createdAt: timestamp (required) - Submission timestamp
//   - updatedAt: timestamp (required) - Last update timestamp
//   * Access pattern: Read by owner and matched builders; create-only by owner; updates/deletes disabled.
//
// Subcollection: connectionRequests/{requestId}/private
// Document ID: contact (Gated contact PII subdocument)
// Fields:
//   - ownerContact: map (required) - Homeowner name, email, phone contact details
//   - streetAddress: string (required, <= 200 chars) - Exact parcel street address
//   - exactAPN: string (optional, nullable, <= 100 chars) - Assessor's parcel number
//   - snapshot: map (required) - Full feasibility report data payload
//   - createdAt: timestamp (required) - Creation timestamp
//   * Access pattern: Read by owner or builders holding a leadUnlocks grant; create by owner; updates disabled.
//
// Subcollection: connectionRequests/{requestId}/builderResponses
// Document ID: {builderId} (Responding builder Auth UID)
// Fields:
//   - builderId: string (required, matches path) - Builder Auth UID
//   - status: string (required, "new" on create, enum: "new" | "interested" | "not-a-fit")
//   - createdAt: timestamp (required, immutable on update)
//   - updatedAt: timestamp (required)
//   * Access pattern: Created by homeowner for matched builders; updated by matched builder; deletes disabled.
//
// Collection: leadUnlocks
// Document ID: {builderId}_{requestId} (Deterministic idempotency key)
// Fields: Managed strictly by Stripe webhook / server Admin SDK. Read-only for owning builder.
//
// Collection: certificatePurchases
// Document ID: {uid}_{certKey} (Deterministic purchase key)
// Fields: Managed strictly by Stripe webhook / server Admin SDK. Read-only for owning purchaser.
//
// Collection: purchaseGrants
// Document ID: {grantId} (Deterministic grant key)
// Fields: Managed strictly by store receipt verification / Admin SDK. Read-only for grantee.
//
// Collection: certificateCredits
// Document ID: {uid} (User Auth UID)
// Fields: Managed strictly by server Admin SDK. Read-only for owning user.
//
// Admin-Only Collections (Read and write strictly disabled for all clients):
//   - studioScenarioLeads/{leadId}
//   - agentPasses/{code} and agentPasses/{code}/redemptions/{uid}
//   - feedback/{ticketId}
//   - activeCheckoutSessions/{reservationId}
//   - rtdnEvents/{messageId}
//   - aiRateLimits/{limitId}
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isAuthenticated() &&
        (!("firebase" in request.auth.token) ||
         !("sign_in_provider" in request.auth.token.firebase) ||
         request.auth.token.firebase.sign_in_provider != "anonymous");
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isNonAnonymous() && request.auth.uid == userId;
    }

    function isBuilder(builderId) {
      return isNonAnonymous() && request.auth.uid == builderId;
    }

    function hasUnlockGrant(requestId) {
      return exists(/databases/$(database)/documents/leadUnlocks/$(request.auth.uid + '_' + requestId));
    }

    function isValidRole() {
      return request.resource.data.role in ["user", "builder"];
    }

    // ===============================================================
    // Domain Validators: Users & Legal Consent
    // ===============================================================

    function isWellFormedLegalConsent(consent) {
      return consent is map &&
        consent.keys().hasOnly([
          "termsVersion",
          "privacyVersion",
          "adultConfirmed",
          "acceptedAt"
        ]) &&
        consent.keys().hasAll([
          "termsVersion",
          "privacyVersion",
          "adultConfirmed",
          "acceptedAt"
        ]) &&
        consent.termsVersion is string &&
        consent.termsVersion.size() > 0 &&
        consent.privacyVersion is string &&
        consent.privacyVersion.size() > 0 &&
        consent.adultConfirmed == true &&
        consent.acceptedAt is timestamp;
    }

    function isCurrentLegalConsent(consent) {
      return isWellFormedLegalConsent(consent) &&
        consent.termsVersion == "2026-11-19" &&
        consent.privacyVersion == "2026-11-19" &&
        consent.acceptedAt == request.time;
    }

    // Pages loaded before the 2026-11-19 release (open tabs,
    // the Android app) still send the previous versions when they register a
    // new account. Accept that receipt only where none exists yet, so a stale
    // page can still sign up during the rollout; LegalReacceptGate then asks
    // the account to accept the current documents. Remove once old pages have
    // aged out.
    function isPreviousLegalConsent(consent) {
      return isWellFormedLegalConsent(consent) &&
        ((consent.termsVersion == "2026-11-06" &&
          consent.privacyVersion == "2026-11-06") ||
          (consent.termsVersion == "2026-10-30" &&
          consent.privacyVersion == "2026-10-30") ||
          (consent.termsVersion == "2026-08-26" &&
            consent.privacyVersion == "2026-08-26")) &&
        consent.acceptedAt == request.time;
    }

    function isValidLegalConsentTransition() {
      let hadConsent = resource != null && "legalConsent" in resource.data;
      let hasConsent = "legalConsent" in request.resource.data;

      // Legacy profiles may remain receipt-free until they next accept the
      // current documents. Once a receipt exists it cannot be removed or
      // rewritten with client-chosen versions/timestamps. An unchanged older
      // receipt remains valid so unrelated profile edits keep working after a
      // future policy revision.
      return (!hasConsent && !hadConsent) ||
        (hasConsent && hadConsent &&
          request.resource.data.legalConsent == resource.data.legalConsent) ||
        (hasConsent && !hadConsent &&
          isPreviousLegalConsent(request.resource.data.legalConsent)) ||
        (hasConsent && isCurrentLegalConsent(request.resource.data.legalConsent) &&
          (!hadConsent ||
            resource.data.legalConsent.termsVersion != "2026-11-19" ||
            resource.data.legalConsent.privacyVersion != "2026-11-19"));
    }

    function isValidUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
        "displayName",
        "email",
        "role",
        "legalConsent",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "email",
        "role",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.email is string &&
      request.resource.data.email.size() > 3 &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.role is string &&
      isValidRole() &&
      isValidLegalConsentTransition() &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      (resource == null || request.resource.data.createdAt == resource.data.createdAt) &&
      (
        !("displayName" in request.resource.data) ||
        request.resource.data.displayName == null ||
        (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100)
      ) &&
      (
        resource == null ||
        request.resource.data.role == resource.data.role
      );
    }

    // ===============================================================
    // Domain Validators: Builders
    // ===============================================================

    function isValidBuilderProfile(builderId) {
      return request.resource.data.keys().hasOnly([
        "ownerUid",
        "companyName",
        "contactEmail",
        "phone",
        "licenseNumber",
        "serviceAreas",
        "active",
        "credits",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "ownerUid",
        "companyName",
        "contactEmail",
        "serviceAreas",
        "active",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.ownerUid == builderId &&
      request.resource.data.companyName is string &&
      request.resource.data.companyName.size() > 0 &&
      request.resource.data.companyName.size() <= 160 &&
      request.resource.data.contactEmail is string &&
      request.resource.data.contactEmail.size() > 3 &&
      request.resource.data.contactEmail.size() <= 254 &&
      request.resource.data.serviceAreas is list &&
      request.resource.data.serviceAreas.size() > 0 &&
      request.resource.data.serviceAreas.size() <= 25 &&
      request.resource.data.active is bool &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      (resource == null || request.resource.data.createdAt == resource.data.createdAt) &&
      (!("phone" in request.resource.data) ||
        request.resource.data.phone == null ||
        (request.resource.data.phone is string && request.resource.data.phone.size() <= 50)) &&
      (!("licenseNumber" in request.resource.data) ||
        request.resource.data.licenseNumber == null ||
        (request.resource.data.licenseNumber is string && request.resource.data.licenseNumber.size() <= 100)) &&
      // Credits lockdown: clients cannot create positive balances or alter credits on update.
      // If credits existed on the document, it cannot be deleted by omitting the field.
      (!("credits" in request.resource.data) ?
        (resource == null || !("credits" in resource.data)) :
        (request.resource.data.credits is number &&
          ((resource == null && request.resource.data.credits == 0) ||
           (resource != null && ("credits" in resource.data) && request.resource.data.credits == resource.data.credits))));
    }

    function isValidBuilderResponse(builderId) {
      return request.resource.data.keys().hasOnly([
        "builderId",
        "status",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "builderId",
        "status",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.builderId == builderId &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      (resource == null || request.resource.data.createdAt == resource.data.createdAt) &&
      request.resource.data.status in ["new", "interested", "not-a-fit"];
    }

    // ===============================================================
    // Domain Validators: Connection Requests & Contact PII Paywall
    // ===============================================================

    // Redacted root connection request doc holds no contact info and no street address.
    // PII lives exclusively in the private/contact subcollection.
    function isValidConnectionRequest() {
      return request.resource.data.keys().hasOnly([
        "ownerUid",
        "preview",
        "matchedBuilderIds",
        "status",
        "ownerVerified",
        "headStartUntil",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "ownerUid",
        "preview",
        "matchedBuilderIds",
        "status",
        "ownerVerified",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.ownerUid == request.auth.uid &&
      request.resource.data.preview is map &&
      !("ownerContact" in request.resource.data) &&
      !("snapshot" in request.resource.data) &&
      request.resource.data.matchedBuilderIds is list &&
      request.resource.data.matchedBuilderIds.size() > 0 &&
      request.resource.data.matchedBuilderIds.size() <= 25 &&
      request.resource.data.status == "submitted" &&
      request.resource.data.ownerVerified is bool &&
      request.resource.data.ownerVerified == ("email_verified" in request.auth.token && request.auth.token.email_verified == true) &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      request.resource.data.headStartUntil == null;
    }

    // Gated PII contact payload. Created by owner at submit time;
    // reads require ownership OR an active leadUnlocks grant for the builder.
    function isValidContactSubdoc() {
      return request.resource.data.keys().hasOnly([
        "ownerContact",
        "streetAddress",
        "exactAPN",
        "snapshot",
        "createdAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "ownerContact",
        "streetAddress",
        "snapshot",
        "createdAt"
      ]) &&
      request.resource.data.ownerContact is map &&
      request.resource.data.streetAddress is string &&
      request.resource.data.streetAddress.size() <= 200 &&
      request.resource.data.snapshot is map &&
      request.resource.data.createdAt is timestamp &&
      (!("exactAPN" in request.resource.data) ||
        request.resource.data.exactAPN == null ||
        (request.resource.data.exactAPN is string && request.resource.data.exactAPN.size() <= 100));
    }

    // ===============================================================
    // Domain Validators: Saved Scenarios & Operational Limits
    // ===============================================================
    //
    // CRITICAL OPERATIONAL INVARIANT: Firestore enforces a hard ceiling of 1000
    // evaluated expressions per request. A scenario carrying a fully populated
    // liveParcel (including boundaries, building massing, and market data)
    // consumes a large expression budget.
    //
    // To stay safely under 1000 expressions:
    // 1. We keep hasOnly() to strictly reject unknown fields, but avoid duplicate hasAll().
    //    CEL read errors on missing keys deny writes naturally.
    // 2. Market data, fire hazard, and building massing validations are intentionally
    //    bounded by type and key allowlists without deep redundant sub-key expressions.
    // 3. Saved scenarios are create-only and delete-only (`allow update: if false;`),
    //    completely eliminating the Update Bypass vector.

    function isValidAduConfig(config) {
      return config is map &&
        config.keys().hasOnly([
          "footprint",
          "width",
          "length",
          "height",
          "roof",
          "finish",
          "includeOpenings"
        ]) &&
        config.footprint > 0 &&
        config.footprint <= 2000 &&
        config.width > 0 &&
        config.width <= 80 &&
        config.length > 0 &&
        config.length <= 80 &&
        config.height > 0 &&
        config.height <= 30 &&
        config.roof in ["shed", "gable", "flat"] &&
        config.finish in ["cedar", "lap", "stucco", "board"] &&
        config.includeOpenings is bool;
    }

    function isValidCostPerSqft(costs) {
      return costs is map &&
        costs.keys().hasOnly(["cedar", "lap", "stucco", "board"]) &&
        costs.cedar >= 100 &&
        costs.cedar <= 1000 &&
        costs.lap >= 100 &&
        costs.lap <= 1000 &&
        costs.stucco >= 100 &&
        costs.stucco <= 1000 &&
        costs.board >= 100 &&
        costs.board <= 1000;
    }

    function isValidFinancialAssumptions(assumptions) {
      return assumptions is map &&
        assumptions.keys().hasOnly([
          "costPerSqft",
          "softCostMultiplier",
          "operatingExpenseRatio",
          "rentScenario"
        ]) &&
        isValidCostPerSqft(assumptions.costPerSqft) &&
        assumptions.softCostMultiplier >= 1 &&
        assumptions.softCostMultiplier <= 3 &&
        assumptions.operatingExpenseRatio >= 0 &&
        assumptions.operatingExpenseRatio <= 1 &&
        assumptions.rentScenario in ["conservative", "market", "optimistic"];
    }

    function isValidSetbacks(setbacks) {
      return setbacks is map &&
        setbacks.keys().hasOnly(["front", "rear", "side"]) &&
        setbacks.front >= 0 &&
        setbacks.rear >= 0 &&
        setbacks.side >= 0;
    }

    function isValidBoundaryGeoJson(boundary) {
      return boundary == null || (
        boundary is map &&
        boundary.keys().hasOnly(["type", "coordinates"]) &&
        boundary.type == "Polygon" &&
        boundary.coordinates is list
      );
    }

    function isValidPose(pose) {
      return pose is map &&
        pose.keys().hasOnly(["x", "z", "rotationDeg"]) &&
        pose.x >= -10000 &&
        pose.x <= 10000 &&
        pose.z >= -10000 &&
        pose.z <= 10000 &&
        pose.rotationDeg >= -360 &&
        pose.rotationDeg <= 360;
    }

    // Deliberately calibrated: validates key allowlist and core scalar types
    // without exceeding the 1000-expression ceiling on maximal scenarios.
    function isValidMarketData(market) {
      return market is map &&
        market.keys().hasOnly([
          "rentByBedroom",
          "costMultiplier",
          "operatingExpenseRatio",
          "opexBreakdown",
          "source",
          "area",
          "asOf",
          "sourceUrl",
          "retrievedAt",
          "geography",
          "comparableCount",
          "confidence",
          "components"
        ]) &&
        market.rentByBedroom is map &&
        market.costMultiplier is number &&
        market.source is string &&
        market.area is string &&
        (!("components" in market) || market.components is map);
    }

    function isValidFireHazard(fire) {
      return fire is map &&
        fire.keys().hasOnly(["zone", "responsibility", "source", "checkedAt"]) &&
        fire.zone in ["very-high", "high", "moderate", "none", "unknown"] &&
        fire.source is string &&
        fire.source.size() <= 200 &&
        fire.checkedAt is string;
    }

    // Bounded by budget invariant 2 above: the key allowlist, the `kind` the
    // fee and setback rules branch on, and a capped name. A fully populated
    // parcel left room for no more (2026-11-21: also checking `checkedAt`
    // failed the plan-reference budget test). pickPermitAuthority in
    // lib/permit-authority.ts checks every field when the scenario is read
    // and drops a malformed record, so it falls back to the mailing city.
    function isValidPermitAuthority(authority) {
      return authority is map &&
        authority.keys().hasOnly(["kind", "name", "community", "basis", "checkedAt"]) &&
        authority.kind in ["city", "county"] &&
        authority.name is string &&
        authority.name.size() <= 100;
    }

    function isValidLiveParcel(parcel) {
      return parcel is map &&
        parcel.keys().hasOnly([
          "address",
          "city",
          "lotArea",
          "lotWidth",
          "lotLength",
          "existingHouseSqft",
          "maxLotCoveragePercent",
          "setbacks",
          "zoning",
          "boundaryGeoJson",
          "lat",
          "lng",
          "source",
          "state",
          "zip",
          "county",
          "marketData",
          "dataQuality",
          "fireHazard",
          "permitAuthority",
          "bearingDeg",
          "existingBuilding"
        ]) &&
        parcel.address is string &&
        parcel.address.size() > 0 &&
        parcel.address.size() <= 200 &&
        parcel.city is string &&
        parcel.city.size() > 0 &&
        parcel.city.size() <= 120 &&
        parcel.lotArea > 0 &&
        parcel.lotWidth > 0 &&
        parcel.lotLength > 0 &&
        parcel.existingHouseSqft >= 0 &&
        parcel.maxLotCoveragePercent > 0 &&
        parcel.maxLotCoveragePercent <= 100 &&
        isValidSetbacks(parcel.setbacks) &&
        parcel.zoning is string &&
        parcel.zoning.size() > 0 &&
        parcel.zoning.size() <= 80 &&
        isValidBoundaryGeoJson(parcel.boundaryGeoJson) &&
        parcel.lat >= -90 &&
        parcel.lat <= 90 &&
        parcel.lng >= -180 &&
        parcel.lng <= 180 &&
        parcel.source in ["regrid", "county-gis", "fallback"] &&
        (!("state" in parcel) || (parcel.state is string && parcel.state.size() <= 20)) &&
        (!("zip" in parcel) || (parcel.zip is string && parcel.zip.size() <= 20)) &&
        (!("county" in parcel) || (parcel.county is string && parcel.county.size() <= 100)) &&
        (!("marketData" in parcel) || isValidMarketData(parcel.marketData)) &&
        (!("dataQuality" in parcel) || parcel.dataQuality is map) &&
        (!("fireHazard" in parcel) || isValidFireHazard(parcel.fireHazard)) &&
        (!("permitAuthority" in parcel) || isValidPermitAuthority(parcel.permitAuthority)) &&
        (!("bearingDeg" in parcel) || parcel.bearingDeg is number) &&
        (!("existingBuilding" in parcel) || parcel.existingBuilding is map);
    }

    // Curated catalog plan reference ID validation.
    function isValidPreapprovedPlan(reference) {
      return reference is map &&
        reference.keys().hasOnly(["planId", "jurisdictionId"]) &&
        reference.planId is string && reference.planId.size() <= 100 &&
        reference.planId.matches('^[a-z0-9]+(-[a-z0-9]+)*$') &&
        reference.jurisdictionId is string && reference.jurisdictionId.size() <= 100 &&
        reference.jurisdictionId.matches('^[a-z0-9]+(-[a-z0-9]+)*$');
    }

    function isValidNewScenario() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        "name",
        "parcelId",
        "liveParcel",
        "config",
        "assumptions",
        "version",
        "heightConvention",
        "pose",
        "projectBrief",
        "styleMatchConcept",
        "preapprovedPlan",
        "createdAt",
        "updatedAt"
      ]) &&
      data.name is string &&
      data.name.size() > 0 &&
      data.name.size() <= 160 &&
      data.parcelId is string &&
      data.parcelId.size() > 0 &&
      data.parcelId.size() <= 100 &&
      (!("liveParcel" in data) || isValidLiveParcel(data.liveParcel)) &&
      isValidAduConfig(data.config) &&
      isValidFinancialAssumptions(data.assumptions) &&
      (!("projectBrief" in data) || data.projectBrief is map) &&
      (!("styleMatchConcept" in data) || data.styleMatchConcept is map) &&
      (!("preapprovedPlan" in data) || isValidPreapprovedPlan(data.preapprovedPlan)) &&
      (!("version" in data) || (
        data.version == 2 &&
        data.keys().hasAll(["heightConvention", "pose"])
      )) &&
      (!("heightConvention" in data) || data.heightConvention == "wall") &&
      (!("pose" in data) || isValidPose(data.pose)) &&
      data.createdAt == request.time &&
      data.updatedAt == request.time;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Private lead + durable email queue (Admin SDK only).
    match /studioScenarioLeads/{leadId} {
      allow read, write: if false;
    }

    // Server-side OpenAI and endpoint rate limits (Admin SDK only).
    match /aiRateLimits/{limitId} {
      allow read, write: if false;
    }

    // User profile documents and saved studies.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(userId);
      allow delete: if false;

      match /savedScenarios/{scenarioId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNewScenario();
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    // Builder contractor profiles and accounting ledgers.
    match /builders/{builderId} {
      allow read: if isBuilder(builderId);
      allow create, update: if isBuilder(builderId) && isValidBuilderProfile(builderId);
      allow delete: if false;

      match /ledger/{transactionId} {
        allow read: if isBuilder(builderId);
        allow write: if false;
      }
    }

    // Homeowner ADU connection requests, private contact PII, and builder responses.
    match /connectionRequests/{requestId} {
      allow read: if isNonAnonymous() && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.matchedBuilderIds
      );
      allow create: if isNonAnonymous() && isValidConnectionRequest();
      allow update, delete: if false;

      // PII paywall: readable only by homeowner or builders with an active unlock grant.
      match /private/{privateDoc} {
        allow read: if isNonAnonymous() && (
          get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.ownerUid == request.auth.uid ||
          hasUnlockGrant(requestId)
        );
        allow create: if isNonAnonymous() &&
          get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.ownerUid == request.auth.uid &&
          isValidContactSubdoc();
        allow update, delete: if false;
      }

      // Builder response status tracking.
      match /builderResponses/{builderId} {
        allow read: if isNonAnonymous() && (
          get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.ownerUid == request.auth.uid ||
          request.auth.uid == builderId
        );
        allow create: if isNonAnonymous() &&
          get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.ownerUid == request.auth.uid &&
          builderId in get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.matchedBuilderIds &&
          isValidBuilderResponse(builderId) &&
          request.resource.data.status == "new";
        allow update: if isBuilder(builderId) &&
          request.auth.uid in get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.matchedBuilderIds &&
          isValidBuilderResponse(builderId);
        allow delete: if false;
      }
    }

    // Paid lead-unlock grants: deterministic "{builderId}_{requestId}".
    // Written only by Stripe webhook / server Admin SDK.
    match /leadUnlocks/{lockId} {
      allow read: if isNonAnonymous()
        && resource != null
        && resource.data.builderId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Paid certificate purchases: deterministic "{uid}_{certKey}".
    // Written only by Stripe webhook / server Admin SDK.
    // Anonymous checkout sessions may read their own grant; link/claim preserves or transfers ownership.
    match /certificatePurchases/{purchaseId} {
      allow read: if isSignedIn()
        && resource != null
        && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Recovery ledger prevents replaying a payment into the former guest UID.
    match /certificateTransfers/{transferId} {
      allow read, write: if false;
    }

    // Real estate agent passes and redemptions (Admin SDK only).
    match /agentPasses/{code} {
      allow read, write: if false;
      match /redemptions/{uid} {
        allow read, write: if false;
      }
    }

    // Store purchase grants (Admin SDK only).
    match /purchaseGrants/{grantId} {
      allow read: if isNonAnonymous()
        && resource != null
        && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Certificate credit balance from store grants (Admin SDK only).
    match /certificateCredits/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    // Feedback intake (Admin SDK only).
    match /feedback/{ticketId} {
      allow read, write: if false;
    }

    // Resumable Stripe Checkout reservations (Admin SDK only).
    match /activeCheckoutSessions/{reservationId} {
      allow read, write: if false;
    }

    // Play RTDN dedupe ledger (Admin SDK only).
    match /rtdnEvents/{messageId} {
      allow read, write: if false;
    }
  }
}
