rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBuilder(builderId) {
      return request.auth != null && request.auth.uid == builderId;
    }

    function isValidBuilderProfile(builderId) {
      return request.resource.data.keys().hasOnly([
        "ownerUid",
        "companyName",
        "contactEmail",
        "phone",
        "licenseNumber",
        "serviceAreas",
        "active",
        "credits",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "ownerUid",
        "companyName",
        "contactEmail",
        "serviceAreas",
        "active",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.ownerUid == builderId &&
      request.resource.data.companyName is string &&
      request.resource.data.companyName.size() > 0 &&
      request.resource.data.companyName.size() <= 160 &&
      request.resource.data.contactEmail is string &&
      request.resource.data.contactEmail.size() > 3 &&
      request.resource.data.contactEmail.size() <= 254 &&
      request.resource.data.serviceAreas is list &&
      request.resource.data.serviceAreas.size() > 0 &&
      request.resource.data.serviceAreas.size() <= 25 &&
      request.resource.data.active is bool &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      (resource == null || request.resource.data.createdAt == resource.data.createdAt) &&
      (!("phone" in request.resource.data) ||
        request.resource.data.phone == null ||
        (request.resource.data.phone is string && request.resource.data.phone.size() <= 50)) &&
      (!("licenseNumber" in request.resource.data) ||
        request.resource.data.licenseNumber == null ||
        (request.resource.data.licenseNumber is string && request.resource.data.licenseNumber.size() <= 100)) &&
      (!("credits" in request.resource.data) ||
        (request.resource.data.credits is number &&
          ((resource == null && request.resource.data.credits == 0) ||
           (resource != null && request.resource.data.credits == resource.data.credits))));
    }

    // 1A: the redacted ROOT doc holds no contact info and no street address —
    // only the banded preview. PII lives in the private/contact subcollection.
    function isValidConnectionRequest() {
      return request.resource.data.keys().hasOnly([
        "ownerUid",
        "preview",
        "matchedBuilderIds",
        "status",
        "ownerVerified",
        "headStartUntil",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "ownerUid",
        "preview",
        "matchedBuilderIds",
        "status",
        "ownerVerified",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.ownerUid == request.auth.uid &&
      request.resource.data.preview is map &&
      !("ownerContact" in request.resource.data) &&
      !("snapshot" in request.resource.data) &&
      request.resource.data.matchedBuilderIds is list &&
      request.resource.data.matchedBuilderIds.size() > 0 &&
      request.resource.data.matchedBuilderIds.size() <= 25 &&
      request.resource.data.status == "submitted" &&
      request.resource.data.ownerVerified == true &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      request.resource.data.headStartUntil == null;
    }

    // The gated PII payload. Only the owner may create it (at submit time);
    // reads require ownership OR a leadUnlocks grant for this builder (T3).
    function isValidContactSubdoc() {
      return request.resource.data.keys().hasOnly([
        "ownerContact",
        "streetAddress",
        "exactAPN",
        "snapshot",
        "createdAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "ownerContact",
        "streetAddress",
        "snapshot",
        "createdAt"
      ]) &&
      request.resource.data.ownerContact is map &&
      request.resource.data.streetAddress is string &&
      request.resource.data.streetAddress.size() <= 200 &&
      request.resource.data.snapshot is map &&
      request.resource.data.createdAt is timestamp &&
      (!("exactAPN" in request.resource.data) ||
        request.resource.data.exactAPN == null ||
        (request.resource.data.exactAPN is string && request.resource.data.exactAPN.size() <= 100));
    }

    function hasUnlockGrant(requestId) {
      return exists(/databases/$(database)/documents/leadUnlocks/$(request.auth.uid + '_' + requestId));
    }

    function isValidBuilderResponse(builderId) {
      return request.resource.data.keys().hasOnly([
        "builderId",
        "status",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "builderId",
        "status",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.builderId == builderId &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      (resource == null || request.resource.data.createdAt == resource.data.createdAt) &&
      request.resource.data.status in ["new", "interested", "not-a-fit"];
    }

    function isValidRole() {
      return request.resource.data.role in ["user", "builder"];
    }

    function isWellFormedLegalConsent(consent) {
      return consent is map &&
        consent.keys().hasOnly([
          "termsVersion",
          "privacyVersion",
          "adultConfirmed",
          "acceptedAt"
        ]) &&
        consent.keys().hasAll([
          "termsVersion",
          "privacyVersion",
          "adultConfirmed",
          "acceptedAt"
        ]) &&
        consent.termsVersion is string &&
        consent.termsVersion.size() > 0 &&
        consent.privacyVersion is string &&
        consent.privacyVersion.size() > 0 &&
        consent.adultConfirmed == true &&
        consent.acceptedAt is timestamp;
    }

    function isCurrentLegalConsent(consent) {
      return isWellFormedLegalConsent(consent) &&
        consent.termsVersion == "2026-08-26" &&
        consent.privacyVersion == "2026-08-26" &&
        consent.acceptedAt == request.time;
    }

    function isValidLegalConsentTransition() {
      let hadConsent = resource != null && "legalConsent" in resource.data;
      let hasConsent = "legalConsent" in request.resource.data;

      // Legacy profiles may remain receipt-free until they next accept the
      // current documents. Once a receipt exists it cannot be removed or
      // rewritten with client-chosen versions/timestamps. An unchanged older
      // receipt remains valid so unrelated profile edits keep working after a
      // future policy revision.
      return (!hasConsent && !hadConsent) ||
        (hasConsent && hadConsent &&
          request.resource.data.legalConsent == resource.data.legalConsent) ||
        (hasConsent && isCurrentLegalConsent(request.resource.data.legalConsent) &&
          (!hadConsent ||
            resource.data.legalConsent.termsVersion != "2026-08-26" ||
            resource.data.legalConsent.privacyVersion != "2026-08-26"));
    }

    function isValidUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
        "displayName",
        "email",
        "role",
        "legalConsent",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.keys().hasAll([
        "email",
        "role",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.email is string &&
      request.resource.data.email.size() > 3 &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.role is string &&
      isValidRole() &&
      isValidLegalConsentTransition() &&
      request.resource.data.createdAt is timestamp &&
      request.resource.data.updatedAt is timestamp &&
      (resource == null || request.resource.data.createdAt == resource.data.createdAt) &&
      (
        !("displayName" in request.resource.data) ||
        request.resource.data.displayName == null ||
        (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100)
      ) &&
      (
        !exists(/databases/$(database)/documents/users/$(userId)) ||
        request.resource.data.role == resource.data.role
      );
    }

    // Required fields are enforced by the per-field checks below, not by a
    // matching hasAll(): reading a key that is absent is an error, which denies
    // the write. The paired hasOnly()/hasAll() this file used to carry doubled
    // the evaluated-expression count, and a scenario carrying a full liveParcel
    // then blew Firestore's hard 1000-expression-per-request ceiling. Keep
    // hasOnly() (it rejects unknown fields) and do not reintroduce hasAll().
    function isValidAduConfig(config) {
      return config is map &&
        config.keys().hasOnly([
          "footprint",
          "width",
          "length",
          "height",
          "roof",
          "finish",
          "includeOpenings"
        ]) &&
        config.footprint is number &&
        config.footprint > 0 &&
        config.footprint <= 2000 &&
        config.width is number &&
        config.width > 0 &&
        config.width <= 80 &&
        config.length is number &&
        config.length > 0 &&
        config.length <= 80 &&
        config.height is number &&
        config.height > 0 &&
        config.height <= 30 &&
        config.roof in ["shed", "gable", "flat"] &&
        config.finish in ["cedar", "lap", "stucco", "board"] &&
        config.includeOpenings is bool;
    }

    function isValidCostPerSqft(costs) {
      return costs is map &&
        costs.keys().hasOnly(["cedar", "lap", "stucco", "board"]) &&
        costs.cedar is number &&
        costs.cedar >= 100 &&
        costs.cedar <= 1000 &&
        costs.lap is number &&
        costs.lap >= 100 &&
        costs.lap <= 1000 &&
        costs.stucco is number &&
        costs.stucco >= 100 &&
        costs.stucco <= 1000 &&
        costs.board is number &&
        costs.board >= 100 &&
        costs.board <= 1000;
    }

    function isValidFinancialAssumptions(assumptions) {
      return assumptions is map &&
        assumptions.keys().hasOnly([
          "costPerSqft",
          "softCostMultiplier",
          "operatingExpenseRatio",
          "rentScenario"
        ]) &&
        isValidCostPerSqft(assumptions.costPerSqft) &&
        assumptions.softCostMultiplier is number &&
        assumptions.softCostMultiplier >= 1 &&
        assumptions.softCostMultiplier <= 3 &&
        assumptions.operatingExpenseRatio is number &&
        assumptions.operatingExpenseRatio >= 0 &&
        assumptions.operatingExpenseRatio <= 1 &&
        assumptions.rentScenario in ["conservative", "market", "optimistic"];
    }

    function isValidSetbacks(setbacks) {
      return setbacks is map &&
        setbacks.keys().hasOnly(["front", "rear", "side"]) &&
        setbacks.front is number &&
        setbacks.front >= 0 &&
        setbacks.rear is number &&
        setbacks.rear >= 0 &&
        setbacks.side is number &&
        setbacks.side >= 0;
    }

    function isValidBoundaryGeoJson(boundary) {
      return boundary == null || (
        boundary is map &&
        boundary.keys().hasOnly(["type", "coordinates"]) &&
        boundary.type == "Polygon" &&
        boundary.coordinates is list
      );
    }

    function isValidPose(pose) {
      return pose is map &&
        pose.keys().hasOnly(["x", "z", "rotationDeg"]) &&
        pose.x is number &&
        pose.x >= -10000 &&
        pose.x <= 10000 &&
        pose.z is number &&
        pose.z >= -10000 &&
        pose.z <= 10000 &&
        pose.rotationDeg is number &&
        pose.rotationDeg >= -360 &&
        pose.rotationDeg <= 360;
    }

    // Deliberately shallow, and it must stay that way. Firestore evaluates at
    // most 1000 expressions per request, and a fully populated liveParcel
    // spends most of that budget before reaching this function — validating
    // every market field's range here put the create over the ceiling, so every
    // real save failed with PERMISSION_DENIED (see the maximal-payload case in
    // firestore.rules.test.ts, which is the guard against that returning).
    //
    // What is kept is what rules are actually for here: the allowlist, so an
    // unknown field cannot be smuggled in, and the core types. Range and format
    // checking of market rows is data-integrity work that isValidLiveParcelData
    // in lib/saved-scenarios.ts already does, and this is a private per-owner
    // subcollection — nobody but the owner can read or write it.
    function isValidMarketData(market) {
      return market is map &&
        market.keys().hasOnly([
          "rentByBedroom",
          "costMultiplier",
          "operatingExpenseRatio",
          "opexBreakdown",
          "source",
          "area",
          "asOf",
          "sourceUrl",
          "retrievedAt",
          "geography",
          "comparableCount",
          "confidence"
        ]) &&
        // rentByBedroom/opexBreakdown/geography are bounded by the allowlist
        // above but left unkeyed: their rows come straight from the HUD data
        // files, which may gain columns without a rules deploy.
        market.rentByBedroom is map &&
        market.costMultiplier is number &&
        market.source is string &&
        market.area is string;
    }

    function isValidLiveParcel(parcel) {
      return parcel is map &&
        parcel.keys().hasOnly([
          "address",
          "city",
          "lotArea",
          "lotWidth",
          "lotLength",
          "existingHouseSqft",
          "maxLotCoveragePercent",
          "setbacks",
          "zoning",
          "boundaryGeoJson",
          "lat",
          "lng",
          "source",
          "state",
          "zip",
          "county",
          "marketData"
        ]) &&
        parcel.address is string &&
        parcel.address.size() > 0 &&
        parcel.address.size() <= 200 &&
        parcel.city is string &&
        parcel.city.size() > 0 &&
        parcel.city.size() <= 120 &&
        parcel.lotArea is number &&
        parcel.lotArea > 0 &&
        parcel.lotWidth is number &&
        parcel.lotWidth > 0 &&
        parcel.lotLength is number &&
        parcel.lotLength > 0 &&
        parcel.existingHouseSqft is number &&
        parcel.existingHouseSqft >= 0 &&
        parcel.maxLotCoveragePercent is number &&
        parcel.maxLotCoveragePercent > 0 &&
        parcel.maxLotCoveragePercent <= 100 &&
        isValidSetbacks(parcel.setbacks) &&
        parcel.zoning is string &&
        parcel.zoning.size() > 0 &&
        parcel.zoning.size() <= 80 &&
        isValidBoundaryGeoJson(parcel.boundaryGeoJson) &&
        parcel.lat is number &&
        parcel.lat >= -90 &&
        parcel.lat <= 90 &&
        parcel.lng is number &&
        parcel.lng >= -180 &&
        parcel.lng <= 180 &&
        parcel.source in ["regrid", "county-gis", "fallback"] &&
        (!("state" in parcel) || (parcel.state is string && parcel.state.size() <= 20)) &&
        (!("zip" in parcel) || (parcel.zip is string && parcel.zip.size() <= 20)) &&
        (!("county" in parcel) || (parcel.county is string && parcel.county.size() <= 100)) &&
        (!("marketData" in parcel) || isValidMarketData(parcel.marketData));
    }

    function isValidNewScenario() {
      // `data` is bound once on purpose: re-spelling `request.resource.data` on
      // every line re-walks that path each time, and a scenario carrying a full
      // liveParcel already runs close to Firestore's hard ceiling of 1000
      // evaluated expressions per request.
      let data = request.resource.data;
      return data.keys().hasOnly([
        "name",
        "parcelId",
        "liveParcel",
        "config",
        "assumptions",
        "version",
        "heightConvention",
        "pose",
        "createdAt",
        "updatedAt"
      ]) &&
      data.name is string &&
      data.name.size() > 0 &&
      data.name.size() <= 160 &&
      data.parcelId is string &&
      data.parcelId.size() > 0 &&
      data.parcelId.size() <= 100 &&
      (!("liveParcel" in data) || isValidLiveParcel(data.liveParcel)) &&
      isValidAduConfig(data.config) &&
      isValidFinancialAssumptions(data.assumptions) &&
      // version/heightConvention/pose travel together, mirroring
      // isValidSavedScenario in lib/saved-scenarios.ts. Accepting `version: 2`
      // on its own would store a document migrateDesign refuses to hydrate, so
      // the write would succeed and the scenario would then be invisible.
      // This branch only asserts that the three fields travel together; the two
      // clauses below do the value checks, so `pose` is validated once and not
      // twice.
      (!("version" in data) || (
        data.version == 2 &&
        data.keys().hasAll(["heightConvention", "pose"])
      )) &&
      (!("heightConvention" in data) || data.heightConvention == "wall") &&
      (!("pose" in data) || isValidPose(data.pose)) &&
      data.createdAt == request.time &&
      data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(userId);
      allow delete: if false;
      
      match /savedScenarios/{scenarioId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNewScenario();
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    match /builders/{builderId} {
      // Full builder profiles include contact details, license number, and
      // credits. The owner can read their own profile; homeowner matching uses
      // the authenticated /api/builders/active directory endpoint, which
      // returns a redacted server-built view instead of exposing this document.
      allow read: if isBuilder(builderId);
      allow create, update: if isBuilder(builderId) && isValidBuilderProfile(builderId);
      allow delete: if false;

      match /ledger/{transactionId} {
        allow read: if isBuilder(builderId);
        allow write: if false;
      }
    }

    match /connectionRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.matchedBuilderIds
      );
      allow create: if isSignedIn() && isValidConnectionRequest();
      allow update, delete: if false;

      // PII paywall (1A): the owner can read/create; a matched builder can read
      // only after a leadUnlocks grant exists for them. No client can update or
      // delete the contact payload.
      match /private/{privateDoc} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.ownerUid == request.auth.uid ||
          hasUnlockGrant(requestId)
        );
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.ownerUid == request.auth.uid &&
          isValidContactSubdoc();
        allow update, delete: if false;
      }

      match /builderResponses/{builderId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.ownerUid == request.auth.uid ||
          request.auth.uid == builderId
        );
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.ownerUid == request.auth.uid &&
          builderId in get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.matchedBuilderIds &&
          isValidBuilderResponse(builderId) &&
          request.resource.data.status == "new";
        allow update: if isBuilder(builderId) &&
          request.auth.uid in get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.matchedBuilderIds &&
          isValidBuilderResponse(builderId);
        allow delete: if false;
      }
    }

    // 2A: paid unlock grants. Doc id is the deterministic "{builderId}_{requestId}"
    // so a replayed Stripe webhook is idempotent by construction. Written ONLY by
    // the webhook via the Admin SDK (which bypasses these rules); no client may
    // self-grant.
    match /leadUnlocks/{lockId} {
      // A builder may read a grant only when it exists AND belongs to them. A
      // missing grant is denied (not a clean 404), so no signed-in user can probe
      // whether another builder has unlocked a lead. fetchBuilderInbox reads its
      // own deterministic id and treats the denial as "not unlocked". The PII
      // paywall uses exists() (hasUnlockGrant), which is unaffected.
      allow read: if isSignedIn()
        && resource != null
        && resource.data.builderId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Paid certificate purchases. Doc id is the deterministic "{uid}_{certKey}"
    // so a replayed Stripe webhook is idempotent by construction. Written ONLY by
    // the webhook via the Admin SDK (which bypasses these rules); no client may
    // self-grant. A user reads only their own grant; a missing grant is denied
    // (not a clean 404), so no one can probe another user's purchases.
    match /certificatePurchases/{purchaseId} {
      allow read: if isSignedIn()
        && resource != null
        && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Store purchase grants (Admin SDK only). Clients may read their own.
    match /purchaseGrants/{grantId} {
      allow read: if isSignedIn()
        && resource != null
        && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Certificate credit balance from store grants (Admin SDK only).
    match /certificateCredits/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    // Feedback intake is server-only (Admin SDK).
    match /feedback/{ticketId} {
      allow read, write: if false;
    }

    // Resumable Stripe Checkout reservations (Admin SDK only). One document
    // per entitlement, keyed by a hash of account + purchase, holding the
    // Session id a buyer resumes. No client ever reads or writes them.
    match /activeCheckoutSessions/{reservationId} {
      allow read, write: if false;
    }

    // Play RTDN dedupe ledger (Admin SDK only). Pub/Sub message ids are an
    // internal idempotency record; no client ever reads or writes them.
    match /rtdnEvents/{messageId} {
      allow read, write: if false;
    }
  }
}
