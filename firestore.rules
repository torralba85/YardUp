rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidRole() {
      return request.resource.data.role in ["user", "builder"];
    }

    function isValidUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
        "displayName",
        "email",
        "role",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.email is string &&
      request.resource.data.role is string &&
      isValidRole() &&
      (
        !("displayName" in request.resource.data) ||
        request.resource.data.displayName == null ||
        request.resource.data.displayName is string
      ) &&
      (
        !exists(/databases/$(database)/documents/users/$(userId)) ||
        request.resource.data.role == resource.data.role
      );
    }

    function isValidScenario() {
      return request.resource.data.keys().hasOnly([
        "name",
        "parcelId",
        "config",
        "assumptions",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.name is string &&
      request.resource.data.name.size() > 0 &&
      request.resource.data.name.size() <= 160 &&
      request.resource.data.parcelId is string &&
      request.resource.data.config is map &&
      request.resource.data.assumptions is map;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(userId);
      allow delete: if false;
      
      match /savedScenarios/{scenarioId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidScenario();
        allow delete: if isOwner(userId);
      }
    }
  }
}
