rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBuilder(builderId) {
      return request.auth != null && request.auth.uid == builderId;
    }

    function isValidBuilderProfile(builderId) {
      return request.resource.data.keys().hasOnly([
        "ownerUid",
        "companyName",
        "contactEmail",
        "phone",
        "licenseNumber",
        "serviceAreas",
        "active",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.ownerUid == builderId &&
      request.resource.data.companyName is string &&
      request.resource.data.companyName.size() > 0 &&
      request.resource.data.companyName.size() <= 160 &&
      request.resource.data.contactEmail is string &&
      request.resource.data.contactEmail.size() > 3 &&
      request.resource.data.serviceAreas is list &&
      request.resource.data.serviceAreas.size() > 0 &&
      request.resource.data.serviceAreas.size() <= 25 &&
      request.resource.data.active is bool &&
      (!("phone" in request.resource.data) ||
        request.resource.data.phone == null ||
        request.resource.data.phone is string) &&
      (!("licenseNumber" in request.resource.data) ||
        request.resource.data.licenseNumber == null ||
        request.resource.data.licenseNumber is string);
    }

    function isValidConnectionRequest() {
      return request.resource.data.keys().hasOnly([
        "ownerUid",
        "ownerContact",
        "snapshot",
        "matchedBuilderIds",
        "builderResponseStatuses",
        "status",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.ownerUid == request.auth.uid &&
      request.resource.data.ownerContact is map &&
      request.resource.data.snapshot is map &&
      request.resource.data.matchedBuilderIds is list &&
      request.resource.data.matchedBuilderIds.size() > 0 &&
      request.resource.data.matchedBuilderIds.size() <= 25 &&
      request.resource.data.status == "submitted";
    }

    function isValidBuilderResponse(builderId) {
      return request.resource.data.keys().hasOnly([
        "builderId",
        "status",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.builderId == builderId &&
      request.resource.data.status in ["new", "interested", "not-a-fit"];
    }

    function isBuilderResponseUpdateStatus(status) {
      return status in ["interested", "not-a-fit"];
    }

    function isValidBuilderResponseStatusMapUpdate(builderId) {
      return request.resource.data.builderResponseStatuses is map &&
        isBuilderResponseUpdateStatus(request.resource.data.builderResponseStatuses[builderId]) &&
        (
          (
            "builderResponseStatuses" in resource.data &&
            request.resource.data.builderResponseStatuses
              .diff(resource.data.builderResponseStatuses)
              .affectedKeys()
              .hasOnly([builderId])
          ) ||
          (
            !("builderResponseStatuses" in resource.data) &&
            request.resource.data.builderResponseStatuses.keys().hasOnly([builderId])
          )
        );
    }

    function isValidBuilderResponseDocumentUpdate(builderId) {
      return isValidBuilderResponse(builderId) &&
        isBuilderResponseUpdateStatus(request.resource.data.status) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]) &&
        request.resource.data.updatedAt == request.time;
    }

    function isValidRole() {
      return request.resource.data.role in ["user", "builder"];
    }

    function isValidUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
        "displayName",
        "email",
        "role",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.email is string &&
      request.resource.data.role is string &&
      isValidRole() &&
      (
        !("displayName" in request.resource.data) ||
        request.resource.data.displayName == null ||
        request.resource.data.displayName is string
      ) &&
      (
        !exists(/databases/$(database)/documents/users/$(userId)) ||
        request.resource.data.role == resource.data.role
      );
    }

    function isValidAduConfig(config) {
      return config is map &&
        config.keys().hasOnly([
          "footprint",
          "width",
          "length",
          "height",
          "roof",
          "finish",
          "includeOpenings"
        ]) &&
        config.keys().hasAll([
          "footprint",
          "width",
          "length",
          "height",
          "roof",
          "finish",
          "includeOpenings"
        ]) &&
        config.footprint is number &&
        config.footprint > 0 &&
        config.footprint <= 2000 &&
        config.width is number &&
        config.width > 0 &&
        config.width <= 80 &&
        config.length is number &&
        config.length > 0 &&
        config.length <= 80 &&
        config.height is number &&
        config.height > 0 &&
        config.height <= 30 &&
        config.roof in ["shed", "gable", "flat"] &&
        config.finish in ["cedar", "lap", "stucco", "board"] &&
        config.includeOpenings is bool;
    }

    function isValidCostPerSqft(costs) {
      return costs is map &&
        costs.keys().hasOnly(["cedar", "lap", "stucco", "board"]) &&
        costs.keys().hasAll(["cedar", "lap", "stucco", "board"]) &&
        costs.cedar is number &&
        costs.cedar >= 100 &&
        costs.cedar <= 1000 &&
        costs.lap is number &&
        costs.lap >= 100 &&
        costs.lap <= 1000 &&
        costs.stucco is number &&
        costs.stucco >= 100 &&
        costs.stucco <= 1000 &&
        costs.board is number &&
        costs.board >= 100 &&
        costs.board <= 1000;
    }

    function isValidFinancialAssumptions(assumptions) {
      return assumptions is map &&
        assumptions.keys().hasOnly([
          "costPerSqft",
          "softCostMultiplier",
          "operatingExpenseRatio",
          "rentScenario"
        ]) &&
        assumptions.keys().hasAll([
          "costPerSqft",
          "softCostMultiplier",
          "operatingExpenseRatio",
          "rentScenario"
        ]) &&
        isValidCostPerSqft(assumptions.costPerSqft) &&
        assumptions.softCostMultiplier is number &&
        assumptions.softCostMultiplier >= 1 &&
        assumptions.softCostMultiplier <= 3 &&
        assumptions.operatingExpenseRatio is number &&
        assumptions.operatingExpenseRatio >= 0 &&
        assumptions.operatingExpenseRatio <= 1 &&
        assumptions.rentScenario in ["conservative", "market", "optimistic"];
    }

    function isValidNewScenario() {
      return request.resource.data.keys().hasOnly([
        "name",
        "parcelId",
        "config",
        "assumptions",
        "createdAt",
        "updatedAt"
      ]) &&
      request.resource.data.name is string &&
      request.resource.data.name.size() > 0 &&
      request.resource.data.name.size() <= 160 &&
      request.resource.data.parcelId is string &&
      request.resource.data.parcelId.size() > 0 &&
      isValidAduConfig(request.resource.data.config) &&
      isValidFinancialAssumptions(request.resource.data.assumptions) &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUserProfile(userId);
      allow delete: if false;
      
      match /scenarios/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /builders/{builderId} {
      allow read: if isSignedIn();
      allow create, update: if isBuilder(builderId) && isValidBuilderProfile(builderId);
      allow delete: if false;
    }

    match /connectionRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.matchedBuilderIds
      );
      allow create: if isSignedIn() && isValidConnectionRequest();
      // Allow builders to update only their own nested status within the inline map.
      allow update: if isSignedIn() && request.auth.uid in resource.data.matchedBuilderIds &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(["builderResponseStatuses", "updatedAt"]) &&
                    request.resource.data.updatedAt == request.time &&
                    isValidBuilderResponseStatusMapUpdate(request.auth.uid);
      allow delete: if false;

      match /builderResponses/{builderId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.ownerUid == request.auth.uid ||
          request.auth.uid == builderId
        );
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.ownerUid == request.auth.uid &&
          builderId in get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.matchedBuilderIds &&
          isValidBuilderResponse(builderId) &&
          request.resource.data.status == "new";
        allow update: if isBuilder(builderId) &&
          request.auth.uid in get(/databases/$(database)/documents/connectionRequests/$(requestId)).data.matchedBuilderIds &&
          isValidBuilderResponseDocumentUpdate(builderId);
        allow delete: if false;
      }
    }
  }
}
