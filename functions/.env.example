# Firebase Functions environment variables (example)
# Copy to .env and fill in real values. Do NOT commit .env.

NEXT_PUBLIC_GOOGLE_PLACES_KEY="<browser-safe Places Autocomplete key>"
OPENAI_TEXT_MODEL="gpt-5.6-sol"
OPENAI_IMAGE_MODEL="gpt-5.6-sol"
NEXT_PUBLIC_FIREBASE_API_KEY="<Firebase web API key>"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="<Firebase auth domain>"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="<Firebase project ID>"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="<Firebase storage bucket>"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="<Firebase messaging sender ID>"
NEXT_PUBLIC_FIREBASE_APP_ID="<Firebase web app ID>"
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY="<Firebase App Check reCAPTCHA Enterprise site key>"

# --- Server provider credentials ---
# For local emulation only, these may be placed in functions/.env. Production
# uses Secret Manager bindings declared in functions/index.js:
#   firebase functions:secrets:set GOOGLE_MAPS_API_KEY_SECRET
#   firebase functions:secrets:set REGRID_API_KEY_SECRET
#   firebase functions:secrets:set OPENAI_API_KEY_SECRET
# GOOGLE_MAPS_API_KEY="<server-side Maps Static + Geocoding key>"
# REGRID_API_KEY="<server-side Regrid Parcel API key>"
# OPENAI_API_KEY="<server-side OpenAI API key for AI panels>"

# --- Stripe lead unlock ---
# SECRETS — do NOT put these in .env. Store them in Secret Manager so they are
# injected into the `apiStripe` function at runtime (bound in functions/index.js):
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
# STRIPE_WEBHOOK_SECRET is the signing secret of the Stripe Dashboard webhook
# endpoint pointed at /api/stripe/webhook (event: checkout.session.completed).
# Checkout is restricted to card (immediate) payments, so that single event is
# sufficient; enabling a delayed payment method would also require handling
# checkout.session.async_payment_succeeded / .async_payment_failed.
#
# Non-secret config:
NEXT_PUBLIC_LEAD_UNLOCK_PRICE_CENTS="4900"  # flat unlock price in cents; inlined at BUILD time (rebuild to change)
NEXT_PUBLIC_APP_URL="<https app origin>"    # success/cancel URL fallback when the Origin header is absent
# LOTFOUNDRY_DEMO_UNLOCKS="true"            # DEV ONLY — allow keyless demo grants; never set in production
