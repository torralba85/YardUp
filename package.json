{
  "name": "lotfoundry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:firebase": "next build && node scripts/prepare-firebase.js",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke:firebase": "node scripts/firebase-scenario-smoke.mjs",
    "deploy": "firebase deploy --only hosting,functions,firestore:rules --project yardup-2026",
    "deploy:dry-run": "firebase deploy --only hosting,functions,firestore:rules --project yardup-2026 --dry-run",
    "deploy:rules": "firebase deploy --only firestore:rules --project yardup-2026",
    "hero:mp4": "remotion render remotion/index.ts HeroLot public/hero/hero.mp4",
    "hero:webm": "remotion render remotion/index.ts HeroLot public/hero/hero.webm --codec=vp9",
    "hero:still": "remotion still remotion/index.ts HeroLot public/hero/hero-poster.jpg --frame=179",
    "hero:render": "npm run hero:mp4 && npm run hero:webm && npm run hero:still"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "^2.1.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^16.2.6",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.164.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@remotion/cli": "^4.0.471",
    "@remotion/google-fonts": "^4.0.471",
    "@tailwindcss/postcss": "4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.164.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "firebase-functions": "^7.2.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.10",
    "remotion": "^4.0.471",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  }
}
