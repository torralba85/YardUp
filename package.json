{
  "name": "lotfoundry",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:firebase": "next build && node scripts/prepare-firebase.js",
    "start": "next start",
    "lint": "npm run design:check && eslint . --max-warnings=0",
    "design:generate": "node scripts/design/generate.mjs",
    "design:check": "node scripts/design/generate.mjs --check && node scripts/design/audit.mjs && node --test scripts/design/checks.mjs",
    "design:audit": "node scripts/design/audit.mjs --inventory",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:jev-eval": "node scripts/run-jev-geocode-eval.mjs",
    "test:jev-zoning-eval": "node scripts/run-jev-geocode-eval.mjs lib/server/zoning-classifier.eval.test.ts",
    "test:jev-guide-check": "node scripts/run-jev-geocode-eval.mjs lib/server/guide-claim-check.eval.test.ts",
    "seo:indexnow": "node scripts/indexnow-submit.mjs",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run firestore.rules.test.ts --maxWorkers=1\"",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run test && npx tsc --noEmit && npm run build",
    "repo:public-check": "node scripts/validate-public-repo.mjs",
    "android:validate": "node native/android/scripts/validate-config.mjs",
    "android:validate:live": "node native/android/scripts/validate-config.mjs --verify-live",
    "android:validate:release": "node native/android/scripts/validate-config.mjs --release --verify-live",
    "smoke:firebase": "node scripts/firebase-scenario-smoke.mjs",
    "smoke:signup": "node scripts/firebase-signup-smoke.mjs",
    "smoke:google-sign-in": "node scripts/ci/google-sign-in.mjs",
    "store:feature-graphic": "node scripts/render-feature-graphic.mjs",
    "deploy": "firebase deploy --only hosting,functions,firestore:rules --project yardup-2026",
    "deploy:dry-run": "firebase deploy --only hosting,functions,firestore:rules --project yardup-2026 --dry-run",
    "deploy:rules": "firebase deploy --only firestore:rules --project yardup-2026",
    "hero:mp4": "remotion render remotion/index.ts HeroLot public/hero/hero.mp4",
    "hero:still": "remotion still remotion/index.ts HeroLot public/hero/hero-poster.jpg --frame=179",
    "hero:render": "npm run hero:mp4 && npm run hero:still",
    "demo:mp4": "remotion render remotion/index.ts LotFoundryDemo public/demo/lotfoundry-demo.mp4",
    "demo:still": "remotion still remotion/index.ts LotFoundryDemo public/demo/lotfoundry-demo-poster.jpg --frame=55",
    "demo:render": "npm run demo:mp4 && npm run demo:still",
    "kickstarter:mp4": "remotion render remotion/index.ts LotFoundryKickstarter public/kickstarter/lotfoundry-kickstarter-campaign.mp4",
    "kickstarter:still": "remotion still remotion/index.ts LotFoundryKickstarter public/kickstarter/lotfoundry-kickstarter-poster.jpg --frame=100",
    "kickstarter:render": "npm run kickstarter:mp4 && npm run kickstarter:still"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@remotion/google-fonts": "^4.0.484",
    "@remotion/player": "^4.0.484",
    "@sparkjsdev/spark": "2.2.0",
    "clsx": "^2.1.1",
    "egm96-universal": "^1.1.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "heic2any": "^0.0.4",
    "lucide-react": "^0.553.0",
    "motion": "^12.40.0",
    "next": "^16.3.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "remotion": "^4.0.484",
    "resend": "^6.34.1",
    "stripe": "22.5.0",
    "tailwind-merge": "^3.3.1",
    "three": "0.180.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.60.0",
    "@remotion/cli": "^4.0.484",
    "@tailwindcss/postcss": "4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.8",
    "firebase-functions": "^7.2.5",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.10",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.2.13"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "postcss": "^8.5.10",
    "proxy-addr": "^2.0.8",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "uuid": "^11.1.1",
    "websocket-driver": "^0.7.5"
  }
}
